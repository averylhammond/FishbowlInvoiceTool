# No need to track cache files or IDE-specific files
__pycache__/
.vscode/
.pytest_cache/

# Ignore virtual environment files
venv/

# Ignore generated txt files and logs
debug.txt
results.txt

# Ignore files generated by PyInstaller and the release script
dist/
build/
*.exe
*.spec
release/

# Ignore code coverage files
.coverage
coverage.xml

# Ignore invoices moved into this folder for testing, but keep the folder itself
# so a fresh clone has somewhere to put them
Invoices/*
!Invoices/.gitkeep

# Ignore config files, but keep the folder itself for the same reason
Configs/*
!Configs/.gitkeep

# Ignore the per-machine user settings database
data/